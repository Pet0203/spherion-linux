CONFIG_VENDOR_GOOGLE=y
CONFIG_BOARD_GOOGLE_SPHERION=y
CONFIG_CHROMEOS=y
# Google's production firmware is built without a serial console. This one
# keeps it. Without it depthcharge is completely silent: coreboot publishes no
# serial record in the coreboot tables, so libpayload's 8250 console has no
# device to attach to, and the AP UART goes quiet right after the boot ROM.
# A firmware that waits for a PIN should be able to say so somewhere.
#
# The console is the CCD debug UART, which needs a debug cable (SuzyQable).
# The PIN is never echoed to it.
CONFIG_CONSOLE_SERIAL=y
