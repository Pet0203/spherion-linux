From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pet0203 <Pet0203@users.noreply.github.com>
Date: Thu, 19 Nov 2026 12:00:00 +0000
Subject: [PATCH] arm64: dts: mediatek: mt8192-asurada: enable USB-C
 DisplayPort output

Enable DPI0 and describe the second ANX7625, on i2c7, that turns it into
DisplayPort for both USB-C ports, with its mode switches linked to the
cros-ec-typec connectors. GPIO 7, 8 and 9 are DPBRDG_INT_ODL, DPBRDG_PWREN
and DPBRDG_RST_ODL in this file's gpio-line-names. The existing
anx7625@58 node is a different chip on a different bus: the bridge for the
internal eDP panel.

The wiring follows the ChromeOS kernel's mt8192-asurada.dtsi
(chromeos-6.1), which is where this board's DisplayPort path is described.

This needs "drm/bridge: anx7625: register Type-C mode switches for DP port
selection". Without it the connectors' mode-switch endpoints never resolve,
cros_ec_typec defers its probe forever, and USB-C stops working altogether.

DPI0 tops out at a 150 MHz pixel clock on MT8192, so the external output is
limited to 1920x1080 at 60 Hz. DisplayPort audio is not wired up.
---
 .../boot/dts/mediatek/mt8192-asurada.dtsi     | 169 ++++++++++++++++++
 1 file changed, 169 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt8192-asurada.dtsi b/arch/arm64/boot/dts/mediatek/mt8192-asurada.dtsi
index 0f4b95a67..82a2ef408 100644
--- a/arch/arm64/boot/dts/mediatek/mt8192-asurada.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt8192-asurada.dtsi
@@ -329,6 +329,19 @@
 	cpu-supply = <&mt6315_6_vbuck1>;
 };
 
+&dpi0 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&dpi_pins>;
+	pinctrl-1 = <&dpi_pins_sleep>;
+	status = "okay";
+
+	port {
+		dpi_out: endpoint {
+			remote-endpoint = <&anx7625_dp_in>;
+		};
+	};
+};
+
 &dsi0 {
 	status = "okay";
 };
@@ -461,6 +474,77 @@
 	clock-frequency = <400000>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c7_pins>;
+
+	/* DPI to DisplayPort, routed to either USB-C port */
+	anx_bridge_dp: anx7625@58 {
+		compatible = "analogix,anx7625";
+		reg = <0x58>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&anx7625_dp_pins>;
+		enable-gpios = <&pio 8 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&pio 9 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pio 7 IRQ_TYPE_EDGE_FALLING>;
+		vdd10-supply = <&pp1000_dpbrdg>;
+		vdd18-supply = <&pp1800_dpbrdg>;
+		vdd33-supply = <&pp3300_dpbrdg>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				anx7625_dp_in: endpoint {
+					bus-type = <7>; /* V4L2_FWNODE_BUS_TYPE_DPI */
+					remote-endpoint = <&dpi_out>;
+				};
+			};
+		};
+
+		switches {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			switch@0 {
+				compatible = "typec-switch";
+				reg = <0>;
+				mode-switch;
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					port@0 {
+						reg = <0>;
+
+						anx_typec0: endpoint {
+							remote-endpoint = <&typec_port0>;
+						};
+					};
+				};
+			};
+
+			switch@1 {
+				compatible = "typec-switch";
+				reg = <1>;
+				mode-switch;
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					port@0 {
+						reg = <0>;
+
+						anx_typec1: endpoint {
+							remote-endpoint = <&typec_port1>;
+						};
+					};
+				};
+			};
+		};
+	};
 };
 
 &mfg0 {
@@ -828,6 +912,20 @@
 		};
 	};
 
+	anx7625_dp_pins: anx7625-dp-default-pins {
+		pins-out {
+			pinmux = <PINMUX_GPIO8__FUNC_GPIO8>,
+				 <PINMUX_GPIO9__FUNC_GPIO9>;
+			output-low;
+		};
+
+		pins-in {
+			pinmux = <PINMUX_GPIO7__FUNC_GPIO7>;
+			input-enable;
+			bias-pull-up;
+		};
+	};
+
 	aud_clk_mosi_off_pins: aud-clk-mosi-off-pins {
 		pins-mosi-off {
 			pinmux = <PINMUX_GPIO214__FUNC_GPIO214>,
@@ -1002,6 +1100,51 @@
 		};
 	};
 
+	dpi_pins: dpi-default-pins {
+		pins-dpi {
+			pinmux = <PINMUX_GPIO96__FUNC_DPI_D0>,
+				 <PINMUX_GPIO97__FUNC_DPI_D1>,
+				 <PINMUX_GPIO98__FUNC_DPI_D2>,
+				 <PINMUX_GPIO99__FUNC_DPI_D3>,
+				 <PINMUX_GPIO100__FUNC_DPI_D4>,
+				 <PINMUX_GPIO101__FUNC_DPI_D5>,
+				 <PINMUX_GPIO102__FUNC_DPI_D6>,
+				 <PINMUX_GPIO103__FUNC_DPI_D7>,
+				 <PINMUX_GPIO104__FUNC_DPI_D8>,
+				 <PINMUX_GPIO105__FUNC_DPI_D9>,
+				 <PINMUX_GPIO106__FUNC_DPI_D10>,
+				 <PINMUX_GPIO110__FUNC_DPI_D11>,
+				 <PINMUX_GPIO113__FUNC_DPI_HSYNC>,
+				 <PINMUX_GPIO111__FUNC_DPI_VSYNC>,
+				 <PINMUX_GPIO109__FUNC_DPI_DE>,
+				 <PINMUX_GPIO112__FUNC_DPI_CK>;
+			drive-strength = <6>;
+		};
+	};
+
+	dpi_pins_sleep: dpi-sleep-pins {
+		pins-dpi {
+			pinmux = <PINMUX_GPIO96__FUNC_GPIO96>,
+				 <PINMUX_GPIO97__FUNC_GPIO97>,
+				 <PINMUX_GPIO98__FUNC_GPIO98>,
+				 <PINMUX_GPIO99__FUNC_GPIO99>,
+				 <PINMUX_GPIO100__FUNC_GPIO100>,
+				 <PINMUX_GPIO101__FUNC_GPIO101>,
+				 <PINMUX_GPIO102__FUNC_GPIO102>,
+				 <PINMUX_GPIO103__FUNC_GPIO103>,
+				 <PINMUX_GPIO104__FUNC_GPIO104>,
+				 <PINMUX_GPIO105__FUNC_GPIO105>,
+				 <PINMUX_GPIO106__FUNC_GPIO106>,
+				 <PINMUX_GPIO110__FUNC_GPIO110>,
+				 <PINMUX_GPIO113__FUNC_GPIO113>,
+				 <PINMUX_GPIO111__FUNC_GPIO111>,
+				 <PINMUX_GPIO109__FUNC_GPIO109>,
+				 <PINMUX_GPIO112__FUNC_GPIO112>;
+			drive-strength = <6>;
+			output-low;
+		};
+	};
+
 	i2c0_pins: i2c0-default-pins {
 		pins-bus {
 			pinmux = <PINMUX_GPIO204__FUNC_SCL0>,
@@ -1456,6 +1599,19 @@
 				power-role = "dual";
 				data-role = "host";
 				try-power-role = "source";
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					port@1 {
+						reg = <1>;
+
+						typec_port0: endpoint {
+							remote-endpoint = <&anx_typec0>;
+						};
+					};
+				};
 			};
 
 			usb_c1: connector@1 {
@@ -1465,6 +1621,19 @@
 				power-role = "dual";
 				data-role = "host";
 				try-power-role = "source";
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					port@1 {
+						reg = <1>;
+
+						typec_port1: endpoint {
+							remote-endpoint = <&anx_typec1>;
+						};
+					};
+				};
 			};
 		};
 	};
